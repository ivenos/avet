{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "postUpgradeTasks": {
    "commands": ["sh .github/scripts/changelog.sh dependency"],
    "dataFileTemplate": "{{{depName}}}\t{{#if (equals updateType 'digest')}}{{{currentDigestShort}}}{{else}}{{#if (equals datasource 'docker')}}{{{currentValue}}}{{else}}{{#if currentVersion}}{{{currentVersion}}}{{else}}{{{currentValue}}}{{/if}}{{/if}}{{/if}}\t{{#if (equals updateType 'digest')}}{{{newDigestShort}}}{{else}}{{#if (equals datasource 'docker')}}{{{newValue}}}{{else}}{{#if newVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}{{/if}}\n",
    "fileFilters": ["CHANGELOG.md"]
  },
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci:"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "actions/checkout",
        "actions/upload-artifact",
        "docker/setup-buildx-action",
        "dtolnay/rust-toolchain",
        "Swatinem/rust-cache"
      ],
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "docker-compose"],
      "commitMessagePrefix": "build(docker):"
    },
    {
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "matchPackageNames": ["ivenos/avet"],
      "enabled": false
    },
    {
      "matchPackageNames": ["rust"],
      "groupName": "Rust toolchain"
    },
    {
      "matchDepNames": ["ubuntu"],
      "groupName": "Ubuntu runners"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG SVT_AV1_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "gitlab-releases",
      "depNameTemplate": "AOMediaCodec/SVT-AV1",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG SVT_AV1_HDR_REF=(?<currentDigest>[^\\n]+)"],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "SVT-AV1-HDR",
      "packageNameTemplate": "https://github.com/juliobbv-p/svt-av1-hdr"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG FFMS2_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "FFMS/ffms2",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG VSHIP_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "Vship",
      "packageNameTemplate": "https://codeberg.org/Line-fr/Vship",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG VMAF_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Netflix/vmaf",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": ["ARG RUST_VERSION=(?<currentValue>[^\\n]+)"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rust",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["SVT_AV1_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "gitlab-releases",
      "depNameTemplate": "AOMediaCodec/SVT-AV1",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["SVT_AV1_HDR_REF:\\s*\"?(?<currentDigest>[^\"\\s]+)\"?"],
      "currentValueTemplate": "main",
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "SVT-AV1-HDR",
      "packageNameTemplate": "https://github.com/juliobbv-p/svt-av1-hdr"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["FFMS2_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "FFMS/ffms2",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["VSHIP_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "Vship",
      "packageNameTemplate": "https://codeberg.org/Line-fr/Vship",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["VMAF_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "Netflix/vmaf",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/appimage\\.yml$/",
        "/^\\.github/workflows/build-publish\\.yml$/"
      ],
      "matchStrings": ["RUST_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "rust",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/build-publish\\.yml$/"],
      "matchStrings": ["runner: ubuntu-(?<currentValue>[0-9]+\\.[0-9]+)-arm"],
      "autoReplaceStringTemplate": "runner: ubuntu-{{{newValue}}}-arm",
      "datasourceTemplate": "github-runners",
      "depNameTemplate": "ubuntu"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/appimage\\.yml$/"],
      "matchStrings": ["LINUXDEPLOY_VERSION:\\s*\"?(?<currentValue>[^\"\\s]+)\"?"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "linuxdeploy/linuxdeploy",
      "versioningTemplate": "loose"
    }
  ]
}
